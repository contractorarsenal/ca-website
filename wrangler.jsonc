/**
 * Cloudflare Workers (Workers Builds, Git-connected Worker "ca-website").
 * Mirrors the config Wrangler auto-generated for every production deploy
 * (name, assets at the repo root, observability), committed so that
 * `wrangler versions upload` (non-production branch builds) works too.
 * The Worker script only runs for /api/* (newsletter signup); every other
 * request is served straight from static assets.
 * Secret required: RESEND_API_KEY (Worker > Settings > Variables and Secrets).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ca-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "vars": {},
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
